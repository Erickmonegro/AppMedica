<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<!-- VBox Principal: Contiene las dos filas principales -->
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.Region?>
<VBox spacing="20.0" styleClass="root-pane" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.proyectomedico.appmedicacenfasies.controller.DashboardController">

    <!-- FILA SUPERIOR: Botones y Buscador -->
    <HBox spacing="20.0" alignment="CENTER_LEFT">
        <children>
            <Button fx:id="btnNuevoPaciente" mnemonicParsing="false" styleClass="boton-principal" text="Nuevo Paciente" prefWidth="150.0" />

            <!-- HBox.hgrow="ALWAYS" hace que el buscador ocupe todo el espacio central -->
            <TextField fx:id="txtBuscar" promptText="Buscador" styleClass="buscador-azul" HBox.hgrow="ALWAYS" />

            <Button fx:id="btnAgendarCita" mnemonicParsing="false" styleClass="boton-principal" text="Agendar cita" prefWidth="150.0"/>
        </children>
    </HBox>

    <!-- FILA INFERIOR: Paneles de Contenido (VBox.vgrow="ALWAYS" para ocupar el alto restante) -->
    <HBox spacing="20.0" VBox.vgrow="ALWAYS">
        <children>

            <!-- PANEL IZQUIERDO: Lista de Pacientes -->
            <VBox styleClass="panel-azul" prefWidth="250.0">
                <children>
                    <Label text="Lista de pacientes" styleClass="texto-panel" />
                    <!-- AQUÍ ESTÁ EL COMPONENTE FALTANTE -->
                    <ListView fx:id="listaPacientes" VBox.vgrow="ALWAYS" style="-fx-background-color: transparent; -fx-control-inner-background: transparent;" />
                </children>
            </VBox>

            <!-- PANEL CENTRAL/DERECHO: Área principal de Citas -->
            <VBox styleClass="panel-azul" HBox.hgrow="ALWAYS" spacing="15.0">
                <children>
                    <!-- Cabecera del panel: Título y botón de Vista -->
                    <HBox alignment="CENTER_LEFT">
                        <Label text="📅 Próximas Citas" styleClass="texto-panel" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: white;" />

                        <!-- Region actúa como un "resorte" invisible para empujar el botón a la derecha -->
                        <Region HBox.hgrow="ALWAYS" />

                        <Button mnemonicParsing="false" styleClass="boton-vista" text="Vista" />
                    </HBox>

                    <!-- ========================================== -->
                    <!-- WIDGET DINÁMICO DE CITAS (MAGIA DEL BACKEND) -->
                    <!-- ========================================== -->

                    <!-- fitToWidth="true" obliga a las tarjetas a estirarse a lo ancho del panel -->
                    <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS" style="-fx-background-color: transparent; -fx-background: transparent; -fx-border-color: transparent;">
                        <content>
                            <!-- ESTE ES EL fx:id QUE CONECTAMOS EN EL CONTROLADOR -->
                            <VBox fx:id="vboxCitasDashboard" spacing="12.0" style="-fx-padding: 5px 15px 15px 5px; -fx-background-color: transparent;" />
                        </content>
                    </ScrollPane>

                </children>
            </VBox>

        </children>
    </HBox>

</VBox>