<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox prefWidth="800.0" prefHeight="750.0" spacing="15.0" style="-fx-background-color: #ffffff;" stylesheets="/css/estilos.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.proyectomedico.appmedicacenfasies.controller.sonografia.NuevaSonografiaTiroidesController">

    <padding>
        <Insets top="25.0" right="30.0" bottom="25.0" left="30.0"/>
    </padding>

    <children>
        <Label text="Reporte: Sonografía de Tiroides / Cervical" style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #0b4a9e;"/>
        <Separator />

        <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS" style="-fx-background-color: transparent; -fx-border-color: transparent;">

            <VBox spacing="15.0">
                <padding>
                    <Insets right="10.0" bottom="10.0"/>
                </padding>

                <children>
                    <VBox spacing="10" style="-fx-background-color: #fcfdfd; -fx-padding: 15; -fx-background-radius: 5; -fx-border-color: #e2e8f0; -fx-border-radius: 5;">
                        <Label text="Datos del Paciente" style="-fx-font-weight: bold; -fx-text-fill: #0f172a;" />

                        <HBox spacing="15">
                            <VBox spacing="5" HBox.hgrow="ALWAYS">
                                <Label text="Nombre Completo:" />
                                <TextField fx:id="txtNombrePaciente" promptText="Escriba el nombre del paciente..." />
                            </VBox>

                            <VBox spacing="5" prefWidth="150">
                                <Label text="Cédula (Opcional):" />
                                <TextField fx:id="txtCedulaPaciente" promptText="Ej: 402-0000000-1"/>
                            </VBox>

                            <VBox spacing="5" prefWidth="80">
                                <Label text="Edad:" />
                                <TextField fx:id="txtEdadPaciente" promptText="Ej: 42"/>
                            </VBox>
                        </HBox>
                    </VBox>

                    <Separator />

                    <VBox spacing="5.0" style="-fx-background-color: #fffbeb; -fx-padding: 10; -fx-border-color: #fde68a; -fx-border-radius: 5; -fx-border-width: 2;">
                        <Label text="💡 MODO PLANTILLA ACTIVO" style="-fx-font-weight: bold; -fx-text-fill: #d97706;"/>
                        <Label text="Los textos pre-cargados corresponden a una glándula sana (TI-RADS 1). Modifique los campos y la clasificación si se detectan nódulos o quistes." style="-fx-text-fill: #92400e;" wrapText="true"/>
                    </VBox>

                    <VBox spacing="5.0">
                        <Label text="Glándula Tiroides" style="-fx-font-weight: bold; -fx-text-fill: #475569;"/>
                        <TextArea fx:id="txtGlandulaTiroides" prefRowCount="2" text="Se aprecian ambas glándulas homogéneas con tamaño adecuado." wrapText="true"/>
                    </VBox>

                    <HBox spacing="15.0">
                        <VBox spacing="5.0" HBox.hgrow="ALWAYS">
                            <Label text="Lóbulo Derecho" style="-fx-font-weight: bold; -fx-text-fill: #475569;"/>
                            <TextArea fx:id="txtLobuloDerecho" prefRowCount="2" text="Sin patologías evidentes al momento del estudio." wrapText="true"/>
                        </VBox>
                        <VBox spacing="5.0" HBox.hgrow="ALWAYS">
                            <Label text="Lóbulo Izquierdo" style="-fx-font-weight: bold; -fx-text-fill: #475569;"/>
                            <TextArea fx:id="txtLobuloIzquierdo" prefRowCount="2" text="Sin patologías evidentes al momento del estudio." wrapText="true"/>
                        </VBox>
                    </HBox>

                    <HBox spacing="15.0">
                        <VBox spacing="5.0" HBox.hgrow="ALWAYS">
                            <Label text="Istmo" style="-fx-font-weight: bold; -fx-text-fill: #475569;"/>
                            <TextField fx:id="txtIstmo" text="Sin patologías evidentes al momento del estudio." style="-fx-pref-height: 40px;" />
                        </VBox>
                        <VBox spacing="5.0" HBox.hgrow="ALWAYS">
                            <Label text="Tráquea" style="-fx-font-weight: bold; -fx-text-fill: #475569;"/>
                            <TextField fx:id="txtTraquea" text="Sin alteraciones." style="-fx-pref-height: 40px;" />
                        </VBox>
                    </HBox>

                    <HBox spacing="15.0">
                        <VBox spacing="5.0" HBox.hgrow="ALWAYS">
                            <Label text="Plano Muscular" style="-fx-font-weight: bold; -fx-text-fill: #475569;"/>
                            <TextField fx:id="txtPlanoMuscular" text="Esternocleidomastoideo y trapecio sin alteraciones en ambos lados." style="-fx-pref-height: 40px;" />
                        </VBox>
                        <VBox spacing="5.0" prefWidth="180.0">
                            <Label text="Clasificación TI-RADS" style="-fx-font-weight: bold; -fx-text-fill: #0b4a9e;"/>
                            <TextField fx:id="txtTiRads" text="TI-RADS 1" style="-fx-pref-height: 40px; -fx-font-weight: bold;" />
                        </VBox>
                    </HBox>

                    <Separator />

                    <VBox spacing="5.0" style="-fx-background-color: #f8fafc; -fx-padding: 10; -fx-border-color: #e2e8f0; -fx-border-radius: 5;">
                        <Label text="DIAGNÓSTICO / CONCLUSIÓN" style="-fx-font-weight: bold; -fx-text-fill: #0f172a;"/>
                        <TextArea fx:id="txtDiagnostico" text="ESTUDIO SIN HALLAZGOS PATOLÓGICOS. TI-RADS 1: Glándula tiroides normal." prefRowCount="2" wrapText="true" style="-fx-font-weight: bold;"/>
                    </VBox>
                </children>
            </VBox>
        </ScrollPane>

        <Separator />

        <HBox alignment="CENTER_RIGHT" spacing="15.0" style="-fx-padding: 10 0 0 0;">
            <Button text="Cancelar" onAction="#cerrarVentana" style="-fx-background-color: transparent; -fx-text-fill: #64748b; -fx-font-weight: bold; -fx-cursor: hand;"/>
            <Button text="Guardar y Generar PDF 💾" onAction="#guardarSonografia" style="-fx-background-color: #10b981; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 10 20; -fx-background-radius: 5px; -fx-cursor: hand;"/>
        </HBox>
    </children>
</VBox>