<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox prefWidth="800.0" prefHeight="700.0" spacing="15.0" style="-fx-background-color: #ffffff;" stylesheets="/css/estilos.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.proyectomedico.appmedicacenfasies.controller.sonografia.NuevaSonografiaPelvicaMasculinaController">

    <padding>
        <Insets top="25.0" right="30.0" bottom="25.0" left="30.0"/>
    </padding>

    <children>
        <Label text="Reporte: Sonografía Pélvica Masculina / Prostática" style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #0b4a9e;"/>
        <Separator />

        <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS" style="-fx-background-color: transparent; -fx-border-color: transparent;">

            <VBox spacing="15.0">
                <padding>
                    <Insets right="10.0" bottom="10.0"/>
                </padding>

                <children>
                    <!-- BLOQUE 1: DATOS DEL PACIENTE -->
                    <VBox spacing="10" style="-fx-background-color: #fcfdfd; -fx-padding: 15; -fx-background-radius: 5; -fx-border-color: #e2e8f0; -fx-border-radius: 5;">
                        <Label text="Datos del Paciente" style="-fx-font-weight: bold; -fx-text-fill: #0f172a;" />

                        <HBox spacing="15">
                            <VBox spacing="5" HBox.hgrow="ALWAYS">
                                <Label text="Nombre Completo:" />
                                <TextField fx:id="txtNombrePaciente" promptText="Escriba el nombre del paciente..." />
                            </VBox>

                            <VBox spacing="5" prefWidth="150">
                                <Label text="Cédula (Opcional):" />
                                <TextField fx:id="txtCedulaPaciente" promptText="Ej: 402-0000000-1"/>
                            </VBox>

                            <VBox spacing="5" prefWidth="80">
                                <Label text="Edad:" />
                                <TextField fx:id="txtEdadPaciente" promptText="Ej: 55"/>
                            </VBox>
                        </HBox>
                    </VBox>

                    <Separator />

                    <!-- PANEL DE INSTRUCCIÓN (UX) -->
                    <VBox spacing="5.0" style="-fx-background-color: #fffbeb; -fx-padding: 10; -fx-border-color: #fde68a; -fx-border-radius: 5; -fx-border-width: 2;">
                        <Label text="💡 MODO PLANTILLA ACTIVO" style="-fx-font-weight: bold; -fx-text-fill: #d97706;"/>
                        <Label text="Textos pre-cargados para un estudio NORMAL. Actualice manualmente los volúmenes vesicales y prostáticos." style="-fx-text-fill: #92400e;" wrapText="true"/>
                    </VBox>

                    <!-- BLOQUE 2: VEJIGA -->
                    <VBox spacing="10.0" style="-fx-background-color: #f1f5f9; -fx-padding: 10; -fx-border-radius: 5;">
                        <Label text="Evaluación Vesical" style="-fx-font-weight: bold; -fx-text-fill: #0b4a9e;"/>

                        <VBox spacing="5.0">
                            <Label text="Vejiga" style="-fx-font-weight: bold; -fx-text-fill: #475569;"/>
                            <TextArea fx:id="txtVejiga" prefRowCount="2" text="De paredes regulares, sin lesiones neoformativas evidentes ni litiasis en su interior." wrapText="true"/>
                        </VBox>

                        <HBox spacing="15.0">
                            <VBox spacing="5.0" HBox.hgrow="ALWAYS">
                                <Label text="Volumen Pre-Miccional (cc)" />
                                <TextField fx:id="txtVolumenPre" promptText="Ej: 350 cc" />
                            </VBox>
                            <VBox spacing="5.0" HBox.hgrow="ALWAYS">
                                <Label text="Volumen Post-Miccional (cc)" />
                                <TextField fx:id="txtVolumenPost" promptText="Ej: 20 cc (Residuo no significativo)" />
                            </VBox>
                        </HBox>
                    </VBox>

                    <!-- BLOQUE 3: PRÓSTATA -->
                    <VBox spacing="10.0" style="-fx-background-color: #f1f5f9; -fx-padding: 10; -fx-border-radius: 5; -fx-margin-top: 5;">
                        <Label text="Evaluación Prostática" style="-fx-font-weight: bold; -fx-text-fill: #0b4a9e;"/>

                        <VBox spacing="5.0">
                            <Label text="Próstata" style="-fx-font-weight: bold; -fx-text-fill: #475569;"/>
                            <TextArea fx:id="txtProstata" prefRowCount="2" text="De tamaño conservado, contornos regulares y ecogenicidad homogénea. Cápsula íntegra." wrapText="true"/>
                        </VBox>

                        <VBox spacing="5.0" prefWidth="250.0">
                            <Label text="Volumen Prostático (cc / gramos)" style="-fx-font-weight: bold; -fx-text-fill: #475569;"/>
                            <TextField fx:id="txtVolumenProstata" promptText="Ej: 25 cc" style="-fx-pref-height: 40px;" />
                        </VBox>
                    </VBox>

                    <Separator />

                    <VBox spacing="5.0" style="-fx-background-color: #f8fafc; -fx-padding: 10; -fx-border-color: #e2e8f0; -fx-border-radius: 5;">
                        <Label text="DIAGNÓSTICO / CONCLUSIÓN" style="-fx-font-weight: bold; -fx-text-fill: #0f172a;"/>
                        <TextArea fx:id="txtDiagnostico" text="SONOGRAFÍA PÉLVICA MASCULINA / PROSTÁTICA SIN HALLAZGOS PATOLÓGICOS." prefRowCount="2" wrapText="true" style="-fx-font-weight: bold;"/>
                    </VBox>
                </children>
            </VBox>
        </ScrollPane>

        <Separator />

        <HBox alignment="CENTER_RIGHT" spacing="15.0" style="-fx-padding: 10 0 0 0;">
            <Button text="Cancelar" onAction="#cerrarVentana" style="-fx-background-color: transparent; -fx-text-fill: #64748b; -fx-font-weight: bold; -fx-cursor: hand;"/>
            <Button text="Guardar y Generar PDF 💾" onAction="#guardarSonografia" style="-fx-background-color: #10b981; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 10 20; -fx-background-radius: 5px; -fx-cursor: hand;"/>
        </HBox>
    </children>
</VBox>