<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox prefWidth="750.0" prefHeight="700.0" spacing="15.0" style="-fx-background-color: #ffffff;" stylesheets="@../css/estilos.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.proyectomedico.appmedicacenfasies.controller.sonografia.NuevaSonografiaAbdominalController">

    <padding>
        <Insets top="25.0" right="30.0" bottom="25.0" left="30.0"/>
    </padding>

    <children>
        <Label text="Reporte: Sonografía Abdominal" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #0b4a9e;"/>
        <Separator />

        <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS" style="-fx-background-color: transparent; -fx-border-color: transparent;">

            <VBox spacing="15.0">
                <padding>
                    <Insets right="10.0" bottom="10.0"/>
                </padding>

                <children>
                    <VBox spacing="10" style="-fx-background-color: #f8fafc; -fx-padding: 15; -fx-background-radius: 5; -fx-border-color: #e2e8f0; -fx-border-radius: 5;">
                        <Label text="Datos del Paciente" style="-fx-font-weight: bold; -fx-text-fill: #0f172a;" />

                        <HBox spacing="15">
                            <VBox spacing="5" HBox.hgrow="ALWAYS">
                                <Label text="Nombre Completo:" />
                                <TextField fx:id="txtNombrePaciente" promptText="Escriba el nombre del paciente..." />
                            </VBox>

                            <VBox spacing="5" prefWidth="150">
                                <Label text="Cédula (Opcional):" />
                                <TextField fx:id="txtCedulaPaciente"/>
                            </VBox>

                            <VBox spacing="5" prefWidth="80">
                                <Label text="Edad:" />
                                <TextField fx:id="txtEdadPaciente"/>
                            </VBox>
                        </HBox>
                    </VBox>

                    <Separator />

                    <HBox spacing="15.0">
                        <VBox spacing="5.0" HBox.hgrow="ALWAYS">
                            <Label text="Hígado" style="-fx-font-weight: bold; -fx-text-fill: #475569;"/>
                            <TextArea fx:id="txtHigado" prefRowCount="2" promptText="Tamaño y textura conservada, bien delimitado..." wrapText="true"/>
                        </VBox>
                        <VBox spacing="5.0" prefWidth="150.0">
                            <Label text="LHD (mm)" style="-fx-font-weight: bold; -fx-text-fill: #475569;"/>
                            <TextField fx:id="txtLhd" promptText="Ej: 112mm" style="-fx-pref-height: 40px;" />
                        </VBox>
                    </HBox>

                    <HBox spacing="15.0">
                        <VBox spacing="5.0" HBox.hgrow="ALWAYS">
                            <Label text="Vesícula Biliar" style="-fx-font-weight: bold; -fx-text-fill: #475569;"/>
                            <TextArea fx:id="txtVesicula" prefRowCount="2" promptText="Paredes finas y regulares..." wrapText="true"/>
                        </VBox>
                        <VBox spacing="5.0" HBox.hgrow="ALWAYS">
                            <Label text="Páncreas" style="-fx-font-weight: bold; -fx-text-fill: #475569;"/>
                            <TextArea fx:id="txtPancreas" prefRowCount="2" promptText="Tamaño, textura y ecogenicidad normal..." wrapText="true"/>
                        </VBox>
                    </HBox>

                    <VBox spacing="5.0">
                        <Label text="Conducto colédoco y Vena porta" style="-fx-font-weight: bold; -fx-text-fill: #475569;"/>
                        <TextField fx:id="txtColedocoPorta" promptText="De tamaño y calibre normal..." style="-fx-pref-height: 40px;" />
                    </VBox>

                    <HBox spacing="15.0">
                        <VBox spacing="5.0" HBox.hgrow="ALWAYS">
                            <Label text="Riñón Derecho" style="-fx-font-weight: bold; -fx-text-fill: #475569;"/>
                            <TextArea fx:id="txtRinonDerecho" prefRowCount="3" promptText="Forma y tamaño normal..." wrapText="true"/>
                        </VBox>
                        <VBox spacing="5.0" HBox.hgrow="ALWAYS">
                            <Label text="Riñón Izquierdo" style="-fx-font-weight: bold; -fx-text-fill: #475569;"/>
                            <TextArea fx:id="txtRinonIzquierdo" prefRowCount="3" promptText="Forma y tamaño normal..." wrapText="true"/>
                        </VBox>
                    </HBox>

                    <HBox spacing="15.0">
                        <VBox spacing="5.0" HBox.hgrow="ALWAYS">
                            <Label text="Bazo" style="-fx-font-weight: bold; -fx-text-fill: #475569;"/>
                            <TextArea fx:id="txtBazo" prefRowCount="2" promptText="Forma y tamaño normal..." wrapText="true"/>
                        </VBox>
                        <VBox spacing="5.0" HBox.hgrow="ALWAYS">
                            <Label text="Intestinos (Opcional)" style="-fx-font-weight: bold; -fx-text-fill: #475569;"/>
                            <TextArea fx:id="txtIntestinos" prefRowCount="2" promptText="Observaciones adicionales..." wrapText="true"/>
                        </VBox>
                    </HBox>

                    <Separator />

                    <VBox spacing="5.0" style="-fx-background-color: #f8fafc; -fx-padding: 10; -fx-border-color: #e2e8f0; -fx-border-radius: 5;">
                        <Label text="DIAGNÓSTICO / CONCLUSIÓN" style="-fx-font-weight: bold; -fx-text-fill: #0f172a;"/>
                        <TextArea fx:id="txtDiagnostico" prefRowCount="2" wrapText="true" style="-fx-font-weight: bold;"/>
                    </VBox>
                </children>
            </VBox>
        </ScrollPane>

        <Separator />

        <HBox alignment="CENTER_RIGHT" spacing="15.0" style="-fx-padding: 10 0 0 0;">
            <Button text="Cancelar" onAction="#cerrarVentana" style="-fx-background-color: transparent; -fx-text-fill: #64748b; -fx-font-weight: bold; -fx-cursor: hand;"/>
            <Button text="Guardar 💾" onAction="#guardarSonografia" style="-fx-background-color: #10b981; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 10 20; -fx-background-radius: 5px; -fx-cursor: hand;"/>
        </HBox>
    </children>
</VBox>