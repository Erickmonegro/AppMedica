<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<VBox spacing="15.0" style="-fx-background-color: #ffffff; -fx-padding: 20;" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.proyectomedico.appmedicacenfasies.controller.RegistroRapidoController">

    <Label text="Ingreso Rápido de Paciente" textFill="#0b4a9e">
        <font>
            <Font name="System Bold" size="18.0" />
        </font>
    </Label>
    <Separator />

    <GridPane hgap="10" vgap="15">
        <columnConstraints>
            <ColumnConstraints minWidth="100" />
            <ColumnConstraints minWidth="200" hgrow="ALWAYS" />
        </columnConstraints>

        <CheckBox fx:id="chkExtranjero" text="Es Extranjero / Sin Cédula" GridPane.columnIndex="0" GridPane.rowIndex="0" GridPane.columnSpan="2" />
        <Label text="Cédula:" GridPane.columnIndex="0" GridPane.rowIndex="1" />
        <TextField fx:id="txtCedula" promptText="Ej: 402-0000000-1" GridPane.columnIndex="1" GridPane.rowIndex="1" />
        <Label text="Nombre Completo:" GridPane.columnIndex="0" GridPane.rowIndex="2" />
        <TextField fx:id="txtNombre" promptText="Nombre y Apellidos" GridPane.columnIndex="1" GridPane.rowIndex="2" />
        <Label text="Teléfono:" GridPane.columnIndex="0" GridPane.rowIndex="3" />
        <TextField fx:id="txtTelefono" promptText="Ej: 809-000-0000" GridPane.columnIndex="1" GridPane.rowIndex="3" />
        <Label text="Seguro Médico:" GridPane.columnIndex="0" GridPane.rowIndex="4" />
        <ComboBox fx:id="cmbSeguro" editable="true" promptText="Seleccione o escriba..." GridPane.columnIndex="1" GridPane.rowIndex="4" maxWidth="Infinity" />
        <Label text="Fecha Nacimiento:" GridPane.columnIndex="0" GridPane.rowIndex="5" />
        <DatePicker fx:id="dpFechaNacimiento" promptText="Opcional" maxWidth="Infinity" GridPane.columnIndex="1" GridPane.rowIndex="5" />
        <Label text="Sexo:" GridPane.columnIndex="0" GridPane.rowIndex="6" />
        <ComboBox fx:id="cmbSexo" promptText="Seleccione..." maxWidth="Infinity" GridPane.columnIndex="1" GridPane.rowIndex="6" />
    </GridPane>

    <Separator />

    <Label text="Asignación Médica (Sala de Espera)" textFill="#0b4a9e">
        <font>
            <Font name="System Bold" size="14.0" />
        </font>
    </Label>

    <HBox spacing="15">
        <VBox spacing="5" HBox.hgrow="ALWAYS">
            <Label text="Especialidad / Área:" />
            <ComboBox fx:id="cmbEspecialidad" maxWidth="Infinity" promptText="Seleccione Especialidad..." />
        </VBox>

        <VBox spacing="5" HBox.hgrow="ALWAYS">
            <Label text="Motivo de Visita:" />
            <ComboBox fx:id="cmbMotivo" maxWidth="Infinity" promptText="Seleccione Motivo..." />
        </VBox>

        <VBox fx:id="vboxTipoEstudio" spacing="5" HBox.hgrow="ALWAYS" visible="false" managed="false">
            <Label text="Tipo de Estudio:" style="-fx-text-fill: #ea580c; -fx-font-weight: bold;"/>
            <ComboBox fx:id="cmbTipoEstudio" maxWidth="Infinity" promptText="Seleccione Sonografía..." style="-fx-border-color: #ea580c; -fx-border-radius: 3;"/>
        </VBox>

        <VBox spacing="5" HBox.hgrow="ALWAYS">
            <Label text="Médico Asignado:" />
            <ComboBox fx:id="cmbMedico" maxWidth="Infinity" promptText="Seleccione Médico..." />
        </VBox>
    </HBox>

    <Separator />

    <HBox alignment="CENTER_RIGHT" spacing="10">
        <Button fx:id="btnCancelar" text="Cancelar" onAction="#cerrarVentana" style="-fx-background-color: #e2e8f0; -fx-text-fill: #333;" />
        <Button fx:id="btnRegistrar" text="Enviar a Sala de Espera" onAction="#registrarYAsignar" style="-fx-background-color: #0b4a9e; -fx-text-fill: white; -fx-font-weight: bold;" />
    </HBox>

</VBox>