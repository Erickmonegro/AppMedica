<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.effect.DropShadow?>

<BorderPane style="-fx-background-color: #f1f5f9;" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.proyectomedico.appmedicacenfasies.controller.DashboardSecretariaController">

    <top>
        <HBox alignment="CENTER_LEFT" spacing="20" style="-fx-background-color: #0b4a9e; -fx-padding: 15 25 15 25;">
            <effect>
                <DropShadow color="#00000033" radius="5" offsetY="2"/>
            </effect>

            <Label text="CENFASIES | Recepción" textFill="WHITE">
                <font><Font name="System Bold" size="20.0" /></font>
            </Label>

            <Region HBox.hgrow="ALWAYS" />

            <TextField fx:id="txtBuscador" promptText="🔍 Buscar paciente por cédula o nombre..." style="-fx-pref-width: 350; -fx-background-radius: 20; -fx-padding: 8 15; -fx-border-color: transparent;" />

            <Button text="+ Ingreso Rápido" onAction="#abrirVentanaIngresoRapido" style="-fx-background-color: #10b981; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 20; -fx-padding: 8 20; -fx-cursor: hand;" />

            <Button text="Cerrar Sesión" onAction="#cerrarSesion" style="-fx-background-color: transparent; -fx-border-color: #fca5a5; -fx-border-radius: 20; -fx-text-fill: #fca5a5; -fx-font-weight: bold; -fx-padding: 7 15; -fx-cursor: hand;" />
        </HBox>
    </top>
    <!-- ========================================== -->
    <!-- PANEL LATERAL IZQUIERDO (SALA DE ESPERA)   -->
    <!-- ========================================== -->
    <left>
        <!-- 1. Fondo sutil #f8fafc y borde derecho más definido -->
        <VBox spacing="15" style="-fx-background-color: #f8fafc; -fx-padding: 20; -fx-pref-width: 300; -fx-border-color: #cbd5e1; -fx-border-width: 0 2 0 0;">

            <!-- 2. Sombra direccional hacia la derecha (offsetX="3") -->
            <effect>
                <DropShadow color="#0000001a" radius="8" offsetX="3" offsetY="0"/>
            </effect>

            <!-- 3. Título en azul corporativo para mayor peso visual -->
            <Label text="⏱️ En Sala de Espera" style="-fx-text-fill: #0b4a9e; -fx-font-weight: bold; -fx-font-size: 16px;"/>

            <!-- Separador un poco más oscuro -->
            <Separator style="-fx-background-color: #cbd5e1;" />

            <!-- ListView transparente para que herede el fondo del panel -->
            <ListView fx:id="listaSalaEspera" VBox.vgrow="ALWAYS" style="-fx-background-color: transparent; -fx-border-color: transparent; -fx-control-inner-background: transparent;" />

        </VBox>
    </left>

    <center>
        <VBox spacing="20" style="-fx-padding: 30;">

            <HBox alignment="CENTER_LEFT">
                <Label text="Lista de paientes" style="-fx-text-fill: #1e293b; -fx-font-weight: bold; -fx-font-size: 24px;"/>
                <Region HBox.hgrow="ALWAYS" />
            </HBox>

            <VBox VBox.vgrow="ALWAYS" style="-fx-background-color: white; -fx-background-radius: 10; -fx-padding: 10; -fx-border-color: #e2e8f0; -fx-border-radius: 10;">
                <effect>
                    <DropShadow color="#cbd5e1" radius="10" spread="0.01" offsetY="3"/>
                </effect>

                <TableView fx:id="tablaPacientesGlobal" VBox.vgrow="ALWAYS" style="-fx-background-color: white; -fx-border-color: transparent;">
                    <columns>
                        <TableColumn fx:id="colCedula" text="Cédula" prefWidth="150" />
                        <TableColumn fx:id="colNombre" text="Nombre Completo" prefWidth="350" />
                        <TableColumn fx:id="colUltimaVisita" text="Última Visita" prefWidth="180" style="-fx-alignment: CENTER;" />
                    </columns>

                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                    </columnResizePolicy>
                </TableView>
            </VBox>

        </VBox>
    </center>

</BorderPane>